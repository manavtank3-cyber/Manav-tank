<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101510">
<title>FitGlow Personal Coach</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101510;color:#f5f5f5;font-family:Arial,sans-serif}
header{padding:24px 18px;background:#182019;border-bottom:1px solid #304b31}
header h1{margin:0;color:#8cff75;font-size:27px}
header p{color:#b6c5b5;margin-bottom:0}
main{padding:18px;max-width:650px;margin:auto}
.card{background:#1b241c;border:1px solid #304b31;border-radius:16px;padding:18px;margin-bottom:16px}
h2{font-size:19px;margin-top:0}
.green{color:#8cff75}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stat{background:#111811;border-radius:12px;padding:14px}
.stat strong{display:block;font-size:25px;color:#8cff75;margin-top:8px}
button{background:#8cff75;color:#101510;border:0;border-radius:10px;padding:12px 16px;font-weight:bold;font-size:15px;cursor:pointer}
button:active{transform:scale(.98)}
.water-buttons{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
ul{padding-left:20px;line-height:1.9;color:#d8e1d7}
footer{text-align:center;padding:24px;color:#91a18f;font-size:13px}
</style>
</head>
<body>
<header>
<h1>FitGlow 💚</h1>
<p>Your personal fitness journey starts here.</p>
</header>
<main>
<section class="card">
<h2>Welcome back! 👋</h2>
<p>Small steps every day. Stronger every week.</p>
<div class="stats">
<div class="stat">Today's goal<strong>30 min</strong>Workout</div>
<div class="stat">Water intake<strong id="water">0 / 8</strong>Glasses today</div>
</div>
</section><section class="card">
<h2>💧 Water Tracker</h2>
<p>Track your glasses of water today.</p>
<div class="water-buttons">
<button onclick="changeWater(1)">+ Add 1 glass</button>
<button onclick="changeWater(-1)">− Remove 1</button>
</div>
<p id="waterMessage" class="green">You've got this!</p>
</section><section class="card">
<h2>🏋️ Today's Beginner Workout</h2>
<ul>
<li>March in place — 3 minutes</li>
<li>Wall push-ups — 2 sets of 10</li>
<li>Chair squats — 2 sets of 8</li>
<li>Standing knee raises — 2 minutes</li>
<li>Gentle stretching — 5 minutes</li>
</ul>
<p>Start slowly and rest whenever needed.</p>
</section><section class="card">
<h2>🎯 Your Daily Habits</h2>
<label><input type="checkbox"> Complete your workout</label><br><br>
<label><input type="checkbox"> Eat balanced meals</label><br><br>
<label><input type="checkbox"> Take a short walk</label><br><br>
<label><input type="checkbox"> Sleep on time</label>
</section>
</main>
<footer>FITGLOW PERSONAL COACH · KEEP MOVING 💚</footer>
<script>
let glasses=Number(localStorage.getItem('fitglowWater')||0);
function renderWater(){
document.getElementById('water').textContent=glasses+' / 8';
document.getElementById('waterMessage').textContent=
glasses>=8?'Daily target reached! Great job! 💚':'Keep going at your own pace!';
}
function changeWater(amount){
glasses=Math.max(0,glasses+amount);
localStorage.setItem('fitglowWater',glasses);
renderWater();
}
renderWater();
</script>
</body>
</html>
